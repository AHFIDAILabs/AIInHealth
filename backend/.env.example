# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=5000

# Leave MONGO_URI unset in local dev to auto-use an in-memory MongoDB (see src/config/db.ts).
# Set it to a real MongoDB Atlas URI for staging/production.
MONGO_URI=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=dev-only-access-secret-change-me-please-32chars+
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

COOKIE_DOMAIN=localhost
# strict | lax | none — use 'none' only if frontend and backend end up on genuinely
# unrelated domains (no shared registrable suffix); 'none' requires HTTPS.
COOKIE_SAME_SITE=lax
FRONTEND_ORIGIN=http://localhost:5173

# How many reverse-proxy hops sit in front of this server — see the detailed
# comment on TRUST_PROXY_HOPS in src/config/env.ts before changing this.
# 1 = just your hosting platform's own load balancer (Render/Railway/Fly's
# default). If a CDN like Cloudflare also proxies your domain, that's +1 (so
# 2 total). Wrong in either direction is a real problem: too low means every
# logged IP looks like an internal address instead of the real visitor; too
# high (or unconditional) lets a client forge its own IP and bypass rate
# limits/IP blocks entirely.
TRUST_PROXY_HOPS=1

# Password reset tokens
RESET_TOKEN_TTL_MINUTES=30

# Paystack — REQUIRED in staging/production (env.ts enforces this at startup).
# Leaving these blank in local dev disables real checkout: initialize just
# no-ops with a log line and a fake authorization_url, and verify
# auto-succeeds — but a blank key in production would make the public payment
# verify endpoint unconditionally report every reference as paid, so it can
# never silently fall back there.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Email — Microsoft Graph app-only auth (client-credentials flow). Requires an Entra ID
# app registration with an admin-consented Mail.Send *application* permission (not
# delegated), and MS_SENDER_EMAIL must be a real mailbox that app is allowed to send as.
# Leave these empty in dev to log reset/invite emails to the console instead of sending them.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=
SUPPORT_EMAIL=

# Web Push (VAPID) — generate a pair with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Each deployment (dev/staging/prod) should have its own key pair — never share one
# across environments, and never commit real values here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Groq — AI feature suite (services/ai/*). Get a key at console.groq.com/keys.
# Leaving this blank disables all AI features with a clean per-feature fallback
# (empty suggested field, "not available right now" message, etc.) — nothing
# else in the app depends on this being set.
# Model IDs verified live at build time — re-check console.groq.com/v1/models
# before ever changing these, model rosters drift. Both models share the same
# free-tier daily cap (1,000 req/day) on this account, hence both budgets below
# matching — this is a quality/speed choice between the two, not a quota one.
GROQ_API_KEY=
GROQ_MODEL_STANDARD=openai/gpt-oss-20b
GROQ_MODEL_ADVANCED=openai/gpt-oss-120b
AI_DAILY_BUDGET_ADVANCED=1000
AI_DAILY_BUDGET_STANDARD=1000

# Cloudinary — every profile/logo photo upload (admin settings, delegate portal,
# speakers, partners, innovations) goes here; there's no local-disk fallback.
# Find these on your Cloudinary dashboard under Account Details.
# Leaving these blank returns a clear 503 from the upload endpoint rather than
# silently no-opping like the integrations above — there's no safe fake image URL
# to hand back to a caller expecting one.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

LOG_LEVEL=info

# --- Seed script (npm run seed) ---
SEED_SUPER_ADMIN_NAME=AHFID Super Admin
SEED_SUPER_ADMIN_EMAIL=admin@aihealthsummit2026.ng
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!strong
