VITE_API_URL=http://localhost:5000/api/v1

# Open-access compendium — the /compendium/* public routes, nav/footer links,
# and sitemap entries. On by default; set to false to turn it off (e.g. before
# any abstract has actually been published — see docs/compendium/PUBLISHING.md).
# See scripts/compendium/exportSnapshot.ts (backend) for the data these pages read.
VITE_COMPENDIUM_ENABLED=true

# Attendee/presenter/speaker "I will be attending/presenting/speaking" DP
# cards + the feedback QR system — see the Batch 0-5 plan. On by default;
# set to false to turn it off.
VITE_EVENT_EXTRAS_ENABLED=true

# Portal Engagement Score + public Leaderboard (nav entry + /portal/leaderboard
# + the opt-in toggle on My Ticket). On by default; set to false to turn it off.
VITE_LEADERBOARD_ENABLED=true

# Delegate Directory — deliberately hidden for now (not deleted). Leave unset/
# false; set to true to bring the nav entry, route, and directory-opt-in
# toggle back with zero data/migration changes.
# VITE_DIRECTORY_ENABLED=true

# Firebase Analytics — see src/lib/analytics.ts. Get these from Firebase
# console > Project settings > General > Your apps > Web app > SDK setup.
# Analytics only actually initializes in a production build (import.meta.env.PROD),
# so these can be left blank in local dev without anything breaking.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
